# Vorlage für die Umgebungsvariablen.
#
#   cp .env.example .env
#
# .env ist in .gitignore – echte Zugangsdaten gehören nie ins Repo.
# In Coolify werden dieselben Variablen unter "Environment Variables"
# gesetzt; Passwörter und Keys dort als Secret markieren.

# --------------------------------------------------------------- Allgemein

# Bestimmt, wann "Freitag 07:00" ist.
TZ=Europe/Berlin

# Image, das docker-compose zieht. Die Pipeline veröffentlicht es hier.
ESSENSPLANER_IMAGE=ghcr.io/felixue/essensplaner:latest

# ------------------------------------------------------------------- Mail

# SMTP-Zugang des Mailanbieters.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=essensplaner@example.com
SMTP_PASSWORD=
# STARTTLS auf Port 587 (Standard) oder SSL auf Port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# Absender und Empfänger. MAIL_TO nimmt mehrere Adressen, mit Komma getrennt.
MAIL_FROM=essensplaner@example.com
MAIL_TO=erste.person@example.com,zweite.person@example.com

# --------------------------------------------------------- Weboberflaeche

# Passwort fuer die Weboberflaeche. Ist es leer, startet sie gar nicht und
# es laeuft nur der Scheduler. Nicht leer lassen, wenn eine Domain davor haengt.
ESSENSPLANER_WEB_PASSWORT=

# Signiert das Sitzungs-Cookie. Fester Wert, sonst muss man sich nach jedem
# Neustart neu anmelden. Erzeugen z. B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ESSENSPLANER_WEB_SECRET=

ESSENSPLANER_WEB_PORT=8080

# Nur fuer lokalen Betrieb ohne HTTPS. Hinter Coolify auf false lassen,
# sonst wird das Sitzungs-Cookie auch unverschluesselt uebertragen.
ESSENSPLANER_WEB_UNSICHER=false

# --------------------------------------------------------------- Optionen

# Gefriertruhe vorhanden: dann darf der Planer doppelt kochen lassen und
# eine Portion für einen späteren Montag oder Mittwoch einfrieren.
ESSENSPLANER_FREEZER=false

# Fester Seed macht Pläne reproduzierbar. Leer lassen für echten Zufall.
ESSENSPLANER_SEED=

# Rezeptvorschläge über die Claude API. Vorschläge landen in
# data/recipes/_pending/ und werden erst nach Freigabe eingeplant.
ESSENSPLANER_AI=false
ANTHROPIC_API_KEY=

# Optional: Rezepte nach Mealie übertragen (essensplaner mealie-sync).
# URL aus Sicht des Containers, Token aus dem Mealie-Profil (API-Tokens).
MEALIE_URL=
MEALIE_TOKEN=
