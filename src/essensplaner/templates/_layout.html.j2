{#
  Gemeinsames Mail-Layout. Inline-Styles, weil Mailprogramme externe
  Stylesheets und <style>-Blöcke unterschiedlich behandeln. Eine Spalte,
  damit es auf dem Handy ohne Zoom lesbar bleibt.
#}
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ betreff }}</title>
</head>
<body style="margin:0; padding:0; background:#f4f3f0; -webkit-text-size-adjust:100%;">
<div style="display:none; max-height:0; overflow:hidden; opacity:0;">{% block vorschautext %}{% endblock %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f3f0;">
  <tr>
    <td align="center" style="padding:16px 8px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
             style="max-width:620px; background:#ffffff; border-radius:10px; overflow:hidden;
                    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                    color:#23211d; font-size:16px; line-height:1.5;">
        <tr>
          <td style="background:#3d5a40; padding:20px 22px;">
            <div style="font-size:13px; letter-spacing:.09em; text-transform:uppercase; color:#b9cdba;">
              Essensplaner
            </div>
            <h1 style="margin:4px 0 0; font-size:21px; line-height:1.3; color:#ffffff; font-weight:600;">
              {% block titel %}{% endblock %}
            </h1>
            <div style="margin-top:4px; font-size:14px; color:#cedfcf;">
              {% block untertitel %}{% endblock %}
            </div>
          </td>
        </tr>
        <tr>
          <td style="padding:6px 22px 22px;">
            {% block inhalt %}{% endblock %}
          </td>
        </tr>
        <tr>
          <td style="padding:14px 22px 20px; border-top:1px solid #e7e4dd; font-size:12px; color:#7d786e;">
            Automatisch erstellt vom Essensplaner. Rezepte und Regeln liegen im
            Git-Repo, Änderungen dort wirken ab dem nächsten Lauf.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
