{% extends "basis.html.j2" %}
{% block titel %}{{ monat_titel(monat) }} – Essensplaner{% endblock %}

{% block inhalt %}
<h1>{{ monat_titel(monat) }}</h1>

<p class="leise" style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
  <a class="knopf" href="{{ url_for('monat_ansehen', monat=voriger) }}">&larr; {{ monat_titel(voriger) }}</a>
  <a class="knopf" href="{{ url_for('monat_ansehen', monat=naechster) }}">{{ monat_titel(naechster) }} &rarr;</a>
</p>

{% if not plan %}
  <div class="karte">
    <div class="zeile" style="display: block;">
      <p style="margin-top: 0;">Für diesen Monat gibt es noch keinen Plan.</p>
      <p class="leise" style="font-size: 13px;">
        Der Scheduler legt ihn am vorletzten Freitag des Vormonats selbst an.
        Früher geht auch:
      </p>
      <form method="post" action="{{ url_for('monat_erzeugen', monat=monat) }}">
        <input type="hidden" name="csrf" value="{{ csrf_token() }}">
        <button class="knopf haupt" type="submit">Plan jetzt erzeugen</button>
      </form>
    </div>
  </div>
{% else %}

  {% for woche in plan.weeks %}
    <section class="karte">
      <div class="kopf">
        <h2>Woche ab {{ woche.start | datum_kurz }}</h2>
        <span class="spanne">bis {{ woche.ende | datum_kurz }}</span>
        <a class="knopf" style="margin-left: auto;"
           href="{{ url_for('einkauf', monat=monat, freitag=woche.start) }}">Einkauf</a>
      </div>

      {% for meal in woche.meals %}
        {% set rezept = rezepte.get(meal.recipe_slug) %}
        <div class="zeile" id="slot-{{ meal.datum }}-{{ meal.slot }}">
          <div class="tag">
            {{ config.slot_kochtag(meal.slot)[:2] }} {{ meal.datum | datum_kurz }}
          </div>
          <div class="gericht">
            <div class="name">
              {% if rezept %}
                <a href="{{ url_for('rezept_ansehen', slug=meal.recipe_slug) }}"
                   style="color: inherit;">{{ meal.recipe_name }}</a>
              {% else %}{{ meal.recipe_name }}{% endif %}
            </div>
            <div class="unten">
              {% if meal.tage > 1 %}
                <span class="marke zwei">{{ meal.tage }} Tage</span>
              {% else %}
                <span class="marke">1 Tag</span>
              {% endif %}
              {{ meal.deckt_ab }}
              {% if rezept %}
                &middot; {{ rezept.prep_minutes }} min
                &middot; {{ "%.0f" | format(rezept.protein_fuer(meal.variant)) }} g Protein
              {% endif %}
              {% if meal.aus_gefriertruhe %}&middot; aus der Gefriertruhe{% endif %}
              {% if meal.batch_cook %}&middot; doppelte Menge{% endif %}
            </div>
          </div>
          <div>
            <a class="knopf"
               href="{{ url_for('tauschen_zeigen', monat=monat, datum=meal.datum, slot=meal.slot) }}">
              Tauschen
            </a>
          </div>
        </div>
      {% endfor %}
    </section>
  {% endfor %}

  {% if statistik %}
    <p class="leise" style="font-size: 12.5px;">
      {{ statistik.slots }} Mahlzeiten in {{ statistik.wochen }} Wochen &middot;
      {{ statistik.verschiedene_gerichte }} verschiedene Gerichte &middot;
      {{ "%.0f" | format(statistik.core_anteil * 100) }} % Kernrezepte &middot;
      Protein in den Vorkoch-Slots mindestens
      {{ "%.0f" | format(statistik.protein_min) }} g
    </p>
  {% endif %}
{% endif %}
{% endblock %}
