{% extends "basis.html.j2" %}
{% block titel %}Rezepte – Essensplaner{% endblock %}

{% block inhalt %}
<h1>Rezepte</h1>
<p class="leise">
  {{ gesamt }} Gerichte im Katalog{% if gestrichen %}, davon {{ gestrichen | length }} gestrichen{% endif %}.
</p>

<div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px;">
  <form method="get" style="display: flex; gap: 8px; flex: 1 1 14rem;">
    <input type="text" name="q" value="{{ suche }}" placeholder="Rezept suchen" autocomplete="off">
    <button class="knopf" type="submit">Suchen</button>
  </form>
  <a class="knopf haupt" href="{{ url_for('rezept_neu') }}">Rezept anlegen</a>
</div>

{% if not rezepte %}
  <p class="leise">Kein Rezept passt zur Suche.</p>
{% else %}
  <div class="karte">
    {% for r in rezepte %}
      <div class="zeile">
        <div class="gericht">
          <div class="name">
            <a href="{{ url_for('rezept_ansehen', slug=r.slug) }}"
               style="color: inherit;">{{ r.name }}</a>
          </div>
          <div class="unten">
            {% if r.slug in gestrichen %}
              <span class="marke warnung">gestrichen</span>
            {% elif r.slug in abgelehnt %}
              <span class="marke warnung">Regelverstoß</span>
            {% endif %}
            {% if r.slug in eigene %}<span class="marke">eigenes</span>{% endif %}
            {% if r.core %}<span class="marke">Kern</span>{% endif %}
            {{ r.slots | join(", ") if r.slots else "ohne Slot" }} &middot;
            {{ r.prep_minutes }} min &middot;
            {{ "%.0f" | format(r.protein_per_serving_g) }} g Protein
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

<p><a class="knopf" href="{{ url_for('start') }}">Zum Monatsplan</a></p>
{% endblock %}

{% block fuss %}
  Gestrichene Gerichte werden nicht mehr eingeplant, bleiben in bestehenden
  Plänen aber stehen.
{% endblock %}
