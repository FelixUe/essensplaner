{% extends "basis.html.j2" %}
{% block titel %}Einkauf {{ woche.start | datum_kurz }} – Essensplaner{% endblock %}

{% block inhalt %}
<h1>Einkaufszettel</h1>
<p class="leise">
  Woche vom {{ woche.start | datum_lang }} bis {{ woche.ende | datum_lang }} &middot;
  {{ woche.meals | length }} Mahlzeiten &middot;
  {{ offen }} {% if offen == 1 %}Posten{% else %}Posten{% endif %} zu holen
  {%- if abgewaehlt %} &middot; {{ abgewaehlt }} abgewählt{% endif %}
</p>

<style>
  .abteilung {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-leise);
    margin-bottom: 4px;
  }
  ul.posten { margin: 0; padding: 0; list-style: none; }
  ul.posten li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 2px 0;
  }
  ul.posten form { display: inline; }
  .haken {
    background: none;
    border: 1px solid var(--linie, #555);
    border-radius: 4px;
    width: 20px;
    height: 20px;
    line-height: 1;
    cursor: pointer;
    color: inherit;
    flex: none;
  }
  .weg { color: var(--ink-leise); text-decoration: line-through; }
  .quelle { color: var(--ink-leise); font-size: 12px; }
</style>

{% for abteilung, posten in gruppen %}
  <section class="karte">
    <div class="kopf">
      <h2>{{ abteilung }}</h2>
      <span class="spanne">{{ posten | rejectattr('abgewaehlt') | list | length }} offen</span>
    </div>
    <div class="zeile" style="display: block;">
      <ul class="posten">
        {% for p in posten %}
          <li id="posten-{{ p.anker }}">
            <form method="post"
                  action="{{ url_for('einkauf_umschalten', monat=monat, freitag=woche.start.isoformat()) }}">
              <input type="hidden" name="csrf" value="{{ csrf_token() }}">
              <input type="hidden" name="key" value="{{ p.key }}">
              <button class="haken" type="submit"
                      title="{% if p.abgewaehlt %}Wieder auf den Zettel{% else %}Hab ich noch{% endif %}"
                      aria-label="{% if p.abgewaehlt %}Wieder auf den Zettel{% else %}Hab ich noch{% endif %}">
                {%- if p.abgewaehlt %}&check;{% endif -%}
              </button>
            </form>
            <span class="{% if p.abgewaehlt %}weg{% endif %}">
              {{ p.text }}
              {%- if p.quelle == 'grund' %}
                <span class="quelle">&middot; immer dabei</span>
              {%- elif p.gerichte %}
                <span class="quelle">&middot; {{ p.gerichte | join(', ') }}</span>
              {%- endif %}
              {%- if p.hinweis %}
                <span class="quelle">&middot; {{ p.hinweis }}</span>
              {%- endif %}
            </span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% else %}
  <section class="karte">
    <div class="zeile"><span class="gericht">Nichts nötig.</span></div>
  </section>
{% endfor %}

<p>
  <a class="knopf" href="{{ url_for('woche_ansehen', monat=monat, freitag=woche.start.isoformat()) }}">Zurück zur Woche</a>
  <a class="knopf" href="{{ url_for('grundeinkauf') }}">Grundeinkauf bearbeiten</a>
  {% if abgewaehlt %}
    <form method="post" style="display: inline;"
          action="{{ url_for('einkauf_zuruecksetzen', monat=monat, freitag=woche.start.isoformat()) }}">
      <input type="hidden" name="csrf" value="{{ csrf_token() }}">
      <button class="knopf" type="submit">Alles wieder anwählen</button>
    </form>
  {% endif %}
</p>
{% endblock %}

{% block fuss %}
  Ein Zettel in Ladenreihenfolge: Frischware, Vorrat und Grundeinkauf
  zusammen. Abgewähltes gilt nur für diesen Zettel – beim nächsten Plan
  steht es wieder drauf.
  {% if not grundeinkauf_eigen %}Der Grundeinkauf ist noch der Vorschlag.{% endif %}
{% endblock %}
